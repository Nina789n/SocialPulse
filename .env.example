# ==============================================
# SocialPulse Environment Configuration
# ==============================================

# Backend Port
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Local MongoDB instance:
MONGODB_URI=mongodb://127.0.0.1:27017/socialpulse

# MongoDB Atlas (Cloud) Alternative:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/socialpulse?retryWrites=true&w=majority

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:5000/api
