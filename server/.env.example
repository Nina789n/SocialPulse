# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For local MongoDB (default port 27017):
MONGODB_URI=mongodb://127.0.0.1:27017/socialpulse

# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/socialpulse?retryWrites=true&w=majority

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173
